{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/vercel_build.sh",
  "outputDirectory": "build/web",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{build/**,lib/**,web/**,tests/**,.dart_tool/**}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}
