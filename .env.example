# Groq API key (https://console.groq.com/keys) — required for AI alerts and coping tips
GROQ_API_KEY=
# Optional: model override
GROQ_MODEL=openai/gpt-oss-20b
# Optional: PostgreSQL URL (Neon / Supabase / Vercel Postgres). Leave empty for local SQLite.
DATABASE_URL=
# Optional: comma-separated allowed origins for local development
CORS_ORIGINS=*
